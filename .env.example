# ==============================================================================
# Email Automation Configuration Template
# Copy this file to .env and configure your sender details.
# NOTE: .env is ignored by git and will NEVER be pushed.
# ==============================================================================

# Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# Obtain a 16-character Google App Password from: https://myaccount.google.com/apppasswords
SMTP_PASS=xxxx xxxx xxxx xxxx

# Sender Profile
SENDER_NAME=Your Full Name
SENDER_EMAIL=your_email@gmail.com

# Safety Guardrails
DAILY_LIMIT=35
DELAY_MIN_SECONDS=45
DELAY_MAX_SECONDS=90
DRY_RUN_MODE=true
BATCH_SIZE=35
SAP_ONLY_FILTER=true
